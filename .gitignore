# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/

# macOS (development machine)
.DS_Store

# Local agent/editor configuration.  Machine-specific by nature -- the one
# that was committed here named a model on somebody's own localhost -- so it
# cannot work on a coworker's machine and does not belong in the tree.
opencode.json
.opencode/
.aider*


# Runtime output -- the recorder writes here.  Never version experiment data.
data/
*.csv

# ...but the cooldown-10 manifest is an INDEX, not experiment data.  It is the
# curated list of which windows of the archive mean what, it is reviewed as a
# diff, and a clone without it has the data and no idea what any of it is.
!reference/cooldown-10/segments.csv

# NOTE: reference/logs/*.xls ARE tracked on purpose.  They are the only
# empirical record of the plant and every default in control/ is derived
# from them.  ~110 MB total; see CLAUDE.md.

# Derived analysis outputs -- regenerate with analysis/steady.py + plot_steady.py
analysis/*.png
analysis/steady_points.csv
analysis/ladder.csv
analysis/steps*.csv

# The ODE fit cache -- derived, keyed on a digest of its inputs
analysis/.fit_cache/
